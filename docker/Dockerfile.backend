# Pure-backend (API only) image — serves the API but no embedded frontend.
#
# Build (context is the repository root):
#   make docker-backend
# or manually:
#   make build-backend-pure-linux
#   docker build -f docker/Dockerfile.backend -t newapi-edu-pure:latest .
#
# The container refuses to start unless every variable listed in
# REQUIRED_ENV_VARS is set. It defaults to the main database and the ClickHouse
# log database, so an unconfigured container fails fast. Override the list with
# -e REQUIRED_ENV_VARS=... (or set it empty to disable the check).
FROM debian:bullseye-v1.4.1

# Aliyun HTTP mirror (bullseye is EOL; the security/updates pools were removed).
# Installs the CA bundle and tzdata needed for outbound HTTPS and local time.
COPY sources.list /etc/apt/sources.list
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

# Binary inside the build context (produced by make build-backend-pure-linux).
ARG PURE_BINARY=build/newapi-edu-pure

# Required env vars are enforced by the binary at startup (main-backend.go).
ENV REQUIRED_ENV_VARS="SQL_DSN,LOG_SQL_DSN"

WORKDIR /data
COPY ${PURE_BINARY} /newapi-edu-pure

EXPOSE 3000
ENTRYPOINT ["/newapi-edu-pure"]
